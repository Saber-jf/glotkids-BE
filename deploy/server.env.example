# /etc/loplop/server.env  —  chmod 600, owner root. Never in git, never in the app or the panel build.
# openssl rand -hex 32
ADMIN_TOKEN=
# THE DATABASE (PostgreSQL) — required in production (NODE_ENV=production refuses to start without it).
# Supabase: Project Settings → Database → Connection string → "Session pooler" (port 5432) or "Direct";
# not the transaction pooler (6543). The password goes here and nowhere else.
DATABASE_URL=postgres://KULLANICI:PAROLA@SUNUCU:5432/postgres?sslmode=require
# TLS: require (encrypted) | verify (the certificate checked too — then DATABASE_SSL_CA, e.g. Supabase's
# "SSL certificate" from Project Settings → Database). Wins over sslmode= in the URL.
DATABASE_SSL=require
# DATABASE_SSL_CA=/etc/loplop/db-ca.crt
# connections the server keeps open (Supabase free plan: keep it small); one more is the owner lock's
DATABASE_POOL=10
# one server per database (src/storage/owner.ts): how long a starting server waits for another one's lock
# DATABASE_LOCK_WAIT_MS=20000
# DATABASE_REBIND=1   once, by a person's decision: the folder was rebuilt and has the files
# openssl rand -hex 32 — keep a copy OFF the server (a password manager): without it no backup opens
BACKUP_PASSPHRASE=
# the media origin (Caddyfile site 2)
CDN_BASE=https://media.ORNEK.org
# warn on /api/health below this much free disk (bytes)
DISK_WARN_BYTES=5368709120
# ACCOUNTS (Supabase Auth): ../loplop/docs/HESAPLAR.md. Without SUPABASE_URL the panel opens with ADMIN_TOKEN only.
SUPABASE_URL=https://PROJE.supabase.co
SUPABASE_ANON_KEY=
# the server's own key: lists, bans and deletes accounts -- never anywhere else
SUPABASE_SERVICE_ROLE_KEY=
# only for an old project that signs with the shared secret (HS256)
# SUPABASE_JWT_SECRET=
# the first admins of the panel (comma separated)
ADMIN_EMAILS=
AUTH_PROVIDERS=email,google,apple
