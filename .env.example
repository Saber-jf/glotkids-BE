# copy to .env -- or enter the keys from the panel (Ayarlar), which writes them to data/secrets.json
PORT=8787
DATA_DIR=./data
# PostgreSQL. Empty: an embedded Postgres in DATA_DIR/pgdata (development; nothing to install).
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# DATABASE_SSL=require
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Accounts (Supabase Auth; ../loplop/docs/HESAPLAR.md). Unset: the panel opens as before.
# SUPABASE_URL=https://PROJE.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAILS=siz@ornek.org
